# Supabase > Project Settings > API / Connect
# Use somente a Publishable Key. Nunca use Secret Key, service_role ou senha do banco no navegador.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_AQUI

# Assinatura permanece desativada ate a configuracao comercial e server-side.
APEX_BILLING_ENABLED=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DATA_CONTROLLER_NAME=
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Variaveis exclusivas do servidor. Nunca use o prefixo NEXT_PUBLIC nelas.
# Preencha somente no ambiente seguro de desenvolvimento/deploy; nao envie os valores ao Git ou ao ZIP.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SECRET_KEY=
